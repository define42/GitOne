FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' \
    -o /gitone-runner ./cmd/gitone-runner

FROM alpine:3.22
RUN apk add --no-cache ca-certificates docker-cli libvirt-client
COPY --from=build /gitone-runner /gitone-runner
ENTRYPOINT ["/gitone-runner"]
CMD ["-runner-url","http://gitone:8080"]
