FROM golang:1.26.5 AS build
WORKDIR /src
ENV GOFIPS140=certified
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go test ./internal/fipsmode && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' \
    -o /gitone-runner ./cmd/gitone-runner && \
    go version -m /gitone-runner

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /gitone-runner /gitone-runner
ENTRYPOINT ["/gitone-runner"]
CMD ["-runner-url","http://gitone:8080"]
